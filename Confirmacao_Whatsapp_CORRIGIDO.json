  "name": "Confirmação Whatsapp (Corrigido)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Abre a 'caixa dupla' caso a mensagem venha encaminhada de outro workflow\nconst corpoOriginal = $json.body?.body || $json.body || $json;\nconst data = corpoOriginal.data || corpoOriginal;\n\n// Ignora mensagens enviadas por nós mesmos\nif (data.key && data.key.fromMe) {\n  return [];\n}\n\n// Ignora mensagens de status/broadcast\nif (data.key && data.key.remoteJid === 'status@broadcast') {\n  return [];\n}\n\n// Ignora mensagens de grupo\nif (data.key && data.key.remoteJid && data.key.remoteJid.includes('@g.us')) {\n  return [];\n}\n\n// Extrai o texto da mensagem (compatível com todos os formatos Evolution API / Baileys)\nconst msg = data.message || {};\nconst texto = msg.conversation \n  || msg.extendedTextMessage?.text \n  || msg.imageMessage?.caption\n  || msg.buttonsResponseMessage?.selectedDisplayText\n  || msg.buttonsResponseMessage?.selectedButtonId\n  || msg.templateButtonReplyMessage?.selectedId\n  || data.body\n  || data.text\n  || '';\n\n// Extrai e limpa o número (remove @s.whatsapp.net, @lid e sufixos de dispositivo :12)\nconst numeroRaw = data.key?.remoteJid || data.sender || '';\nlet numero = numeroRaw.replace(/@.*$/, '').replace(/:\\d+$/, '').trim();\nif (!numero || numero === '41940523442358' || numero.includes('43787365') || numero.length > 13) {\n  numero = '5511943787365';\n}\n\n// Se não tem texto, ignora\nif (!texto || texto.trim() === '') {\n  return [];\n}\n\n// Ignora mensagens do próprio bot (começam com emojis especiais)\nconst textoLimpo = texto.trim();\nif (textoLimpo.startsWith('✅') || \n    textoLimpo.startsWith('✏️') || \n    textoLimpo.startsWith('📋') || \n    textoLimpo.startsWith('🔄') || \n    textoLimpo.startsWith('⚖️')) {\n  return [];\n}\n\n// Normaliza texto: remove pontuações e acentos\nconst textoSemPontuacao = textoLimpo.replace(/[.,!?:;]/g, '').trim();\nconst textoUpper = textoSemPontuacao.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase();\n\nconst isSim = textoUpper === 'SIM' || textoUpper === 'S' || textoUpper === 'OK' || textoUpper === 'APROVO' || textoUpper.startsWith('SIM ') || textoLimpo.includes('👍');\nconst isNao = textoUpper === 'NAO' || textoUpper === 'N' || textoUpper.startsWith('NAO ') || textoUpper.includes('CORRIG') || textoLimpo.includes('👎');\n\nreturn [{\n  json: {\n    texto: textoLimpo,\n    textoUpper: textoUpper,\n    isSim: isSim,\n    isNao: isNao,\n    numero: numero,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
